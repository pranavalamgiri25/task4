    "import sqlite3\n",
    "import re\n",
    "from flask import Flask, request, jsonify, session\n",
    "import bcrypt\n",
    "\n",
    "app = Flask(__name__)\n",
    "app.secret_key = \"replace_with_a_secure_random_key\"\n",
    "\n",
    "# Database setup\n",
    "def init_db():\n",
    "    with sqlite3.connect(\"users.db\") as conn:\n",
    "        cursor = conn.cursor()\n",
    "        cursor.execute('''\n",
    "            CREATE TABLE IF NOT EXISTS users (\n",
    "                id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "                username TEXT UNIQUE NOT NULL,\n",
    "                password_hash BLOB NOT NULL\n",
    "            )\n",
    "        ''')\n",
    "        conn.commit()\n",
    "\n",
    "init_db()\n",
    "\n",
    "# Input validation helper\n",
    "def is_valid_username(username):\n",
    "    return bool(re.match(r'^[a-zA-Z0-9_]{3,20}$', username))\n",
    "\n",
    "# 1. User Registration\n",
    "@app.route('/register', methods=['POST'])\n",
    "def register():\n",
    "    data = request.get_json() or {}\n",
    "    username = data.get('username', '').strip()\n",
    "    password = data.get('password', '')\n",
    "\n",
    "    if not is_valid_username(username) or len(password) < 6:\n",
    "        return jsonify({\"error\": \"Invalid username (3-20 alphanumeric chars) or password too short (min 6 chars)\"}), 400\n",
    "\n",
    "    # Hash password with bcrypt\n",
    "    salt = bcrypt.gensalt()\n",
    "    hashed = bcrypt.hashpw(password.encode('utf-8'), salt)\n",
    "\n",
    "    try:\n",
    "        with sqlite3.connect(\"users.db\") as conn:\n",
    "            cursor = conn.cursor()\n",
    "            # Parameterized query protects against SQL Injection\n",
    "            cursor.execute(\"INSERT INTO users (username, password_hash) VALUES (?, ?)\", (username, hashed))\n",
    "            conn.commit()\n",
    "        return jsonify({\"message\": \"Registration successful\"}), 201\n",
    "    except sqlite3.IntegrityError:\n",
    "        return jsonify({\"error\": \"Username already exists\"}), 409\n",
    "\n",
    "# 2. User Login\n",
    "@app.route('/login', methods=['POST'])\n",
    "def login():\n",
    "    data = request.get_json() or {}\n",
    "    username = data.get('username', '').strip()\n",
    "    password = data.get('password', '')\n",
    "\n",
    "    with sqlite3.connect(\"users.db\") as conn:\n",
    "        cursor = conn.cursor()\n",
    "        # Parameterized query protects against SQL Injection\n",
    "        cursor.execute(\"SELECT password_hash FROM users WHERE username = ?\", (username,))\n",
    "        row = cursor.fetchone()\n",
    "\n",
    "    if row and bcrypt.checkpw(password.encode('utf-8'), row[0]):\n",
    "        session['user'] = username  # Start session\n",
    "        return jsonify({\"message\": f\"Welcome, {username}! Login successful.\"}), 200\n",
    "\n",
    "    return jsonify({\"error\": \"Invalid username or password\"}), 401\n",
    "\n",
    "# 3. Protected Dashboard Route\n",
    "@app.route('/dashboard', methods=['GET'])\n",
    "def dashboard():\n",
    "    if 'user' in session:\n",
    "        return jsonify({\"message\": f\"Hello {session['user']}, you have accessed protected data.\"}), 200\n",
    "    return jsonify({\"error\": \"Unauthorized. Please log in first.\"}), 401\n",
    "\n",
    "# 4. Logout (Session Management)\n",
    "@app.route('/logout', methods=['POST'])\n",
    "def logout():\n",
    "    session.pop('user', None)  # Invalidate session\n",
    "    return jsonify({\"message\": \"Successfully logged out\"}), 200\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    app.run(debug=True)\n",
    "    "
